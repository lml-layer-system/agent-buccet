{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "lib/lml/agent-boundary/**/*.ts",
    "scripts/agent-buccet-*.ts",
    "scripts/buccet.ts",
    "scripts/prepare-agent-buccet-package.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
