{
  "approvalRequiredFor": [
    "tool.exec",
    "fs.delete",
    "network.send",
    "comm.send"
  ],
  "grants": [
    {
      "resourceKind": "tool",
      "resourceValue": "git",
      "grantedActions": [
        "tool.exec"
      ],
      "metadata": {
        "profile": "tool-lockdown"
      }
    },
    {
      "resourceKind": "path",
      "resourceValue": "/workspace/project",
      "grantedActions": [
        "fs.read"
      ],
      "metadata": {
        "profile": "tool-lockdown"
      }
    }
  ],
  "laws": [
    "TIME.TRUST.01",
    "TIME.AUTHORITY.01",
    "TIME.SCOPE.01",
    "TIME.LAW.01",
    "TIME.SESSION.01",
    "TIME.LEDGER.01",
    "BOUNDARY.DELETE.01",
    "BOUNDARY.EXEC.01",
    "BOUNDARY.NETWORK.01",
    "BOUNDARY.COMM.01"
  ],
  "process": {
    "allowedCommands": [
      "git",
      "npm",
      "node",
      "python",
      "python3"
    ],
    "blockedCommands": [
      "rm",
      "sudo"
    ],
    "allowedEnvPrefixes": [
      "AGENT_BUCCET_",
      "PATH",
      "HOME",
      "TMP",
      "TMPDIR",
      "TEMP",
      "TERM",
      "LANG",
      "LC_",
      "NODE_",
      "npm_"
    ],
    "blockedEnvVars": [
      "AWS_SECRET_ACCESS_KEY",
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "SSH_AUTH_SOCK"
    ],
    "inheritParentEnv": true,
    "enforceScopedCwd": true
  }
}
