{
  "name": "agent-buccet",
  "version": "0.1.0",
  "description": "Persistent law and scope enforcement for AI agents. Agents can propose. They cannot authorize.",
  "keywords": [
    "ai-agents",
    "safety",
    "containment",
    "boundary",
    "llm",
    "policy",
    "audit",
    "ledger",
    "enforcement",
    "authorization"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lml-layer-system/agent-buccet"
  },
  "homepage": "https://github.com/lml-layer-system/agent-buccet#readme",
  "bugs": {
    "url": "https://github.com/lml-layer-system/agent-buccet/issues"
  },
  "type": "module",
  "main": "./lib/agent-buccet/index.ts",
  "exports": {
    ".": "./lib/agent-buccet/index.ts"
  },
  "files": [
    "lib/",
    "data/agent-buccet-law-foundation/",
    "docs/agent-boundary/",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "biome check lib/agent-buccet scripts",
    "lint:fix": "biome check --write lib/agent-buccet scripts",
    "format": "biome format --write lib/agent-buccet scripts",
    "check:agent-buccet:p0": "npm run clean:agent-buccet:artifacts && npm run test:agent-buccet:doc-links && npm run test:agent-buccet:artifact-hygiene",
    "check:agent-buccet:contracts-stable": "npm run test:agent-buccet:gravity-contract && npm run test:agent-buccet:chat-boundary && npm run test:agent-buccet:upl-governance && npm run test:agent-buccet:ledger-contract && npm run test:agent-buccet:wrapper-contract && npm run test:agent-buccet:intercept-daemon && npm run test:agent-buccet:release-witness",
    "check:agent-buccet:contracts-observed": "node scripts/agent-buccet-flake-reliability.ts",
    "check:agent-buccet:contracts-quarantine": "npm run check:agent-buccet:contracts-observed",
    "check:agent-buccet:contracts-core": "npm run check:agent-buccet:contracts-stable",
    "check:agent-buccet:release": "npm run check:agent-buccet:p0 && npm run check:agent-buccet:contracts-stable",
    "build": "npm run typecheck && npm run check:agent-buccet:p0 && node scripts/prepare-agent-buccet-package.ts",
    "demo:agent-buccet": "node scripts/agent-buccet-e2e.ts",
    "demo:agent-buccet:gravity": "node scripts/agent-buccet-gravity-e2e.ts",
    "demo:agent-buccet:attacks": "node scripts/agent-buccet-attack-demo.ts",
    "demo:quickstart": "node examples/quickstart/index.ts",
    "test:agent-buccet:gravity-contract": "node scripts/agent-buccet-gravity-contract.ts",
    "test:agent-buccet:chat-boundary": "node scripts/agent-buccet-chat-boundary-contract.ts",
    "test:agent-buccet:upl-governance": "node scripts/agent-buccet-upl-governance-contract.ts",
    "test:agent-buccet:egress-contract": "node scripts/agent-buccet-egress-contract.ts",
    "test:agent-buccet:governor-contract": "node scripts/agent-buccet-governor-contract.ts",
    "test:agent-buccet:payload-physics-contract": "node scripts/agent-buccet-payload-physics-contract.ts",
    "test:agent-buccet:admission-contract": "node scripts/agent-buccet-admission-contract.ts",
    "test:agent-buccet:foundation": "node scripts/agent-buccet-foundation-contract.ts",
    "test:agent-buccet:time-runtime": "node scripts/agent-buccet-time-runtime-contract.ts",
    "test:agent-buccet:meta-runtime": "node scripts/agent-buccet-meta-runtime-contract.ts",
    "test:agent-buccet:law-unit": "node scripts/agent-buccet-law-unit-contract.ts",
    "test:agent-buccet:ledger-contract": "node scripts/agent-buccet-ledger-contract.ts",
    "test:agent-buccet:ledger-rollup": "node scripts/agent-buccet-ledger-rollup-contract.ts",
    "test:agent-buccet:ledger-writer": "node scripts/agent-buccet-ledger-writer-contract.ts",
    "test:agent-buccet:ledger-witness": "node scripts/agent-buccet-ledger-witness-contract.ts",
    "test:agent-buccet:ledger-perf": "node scripts/agent-buccet-ledger-perf-contract.ts",
    "test:agent-buccet:gravity-supervisor": "node scripts/agent-buccet-gravity-supervisor-contract.ts",
    "test:agent-buccet:wrapper-contract": "node scripts/agent-buccet-wrapper-contract.ts",
    "test:agent-buccet:action-classes": "node scripts/agent-buccet-action-classes-contract.ts",
    "test:agent-buccet:intercept-daemon": "node scripts/agent-buccet-intercept-daemon-contract.ts",
    "test:agent-buccet:intercept-server": "node scripts/agent-buccet-intercept-server-contract.ts",
    "test:agent-buccet:system-intercept": "node scripts/agent-buccet-system-intercept-contract.ts",
    "test:agent-buccet:gravity-bridge": "node scripts/agent-buccet-gravity-bridge-contract.ts",
    "test:agent-buccet:swarm": "node scripts/agent-buccet-swarm-contract.ts",
    "test:agent-buccet:hook-runtime": "node scripts/agent-buccet-hook-runtime-contract.ts",
    "test:agent-buccet:cli": "node scripts/agent-buccet-cli-contract.ts",
    "test:agent-buccet:install": "node scripts/agent-buccet-install-contract.ts",
    "test:agent-buccet:hosted-install": "npm run build && node scripts/agent-buccet-hosted-install-contract.ts",
    "test:agent-buccet:release-witness": "node scripts/agent-buccet-release-witness-contract.ts",
    "clean:agent-buccet:artifacts": "node scripts/agent-buccet-artifact-clean.ts",
    "test:agent-buccet:doc-links": "node scripts/agent-buccet-doc-links-contract.ts",
    "test:agent-buccet:artifact-hygiene": "node scripts/agent-buccet-artifact-hygiene-contract.ts",
    "agent-buccet:gravity-daemon": "node scripts/agent-buccet-gravity-daemon.ts",
    "agent-buccet:intercept-daemon": "node scripts/agent-buccet-intercept-daemon.ts",
    "agent-buccet:intercept-server": "node scripts/agent-buccet-intercept-server.ts",
    "agent-buccet:gravity-bridge": "node scripts/agent-buccet-gravity-bridge.ts",
    "agent-buccet:hook-daemon": "node scripts/agent-buccet-hook-daemon.ts",
    "agent-buccet:system-intercept-bridge": "node scripts/agent-buccet-system-intercept-bridge.ts",
    "agent-buccet:ledger-writer": "node scripts/agent-buccet-ledger-writer.ts",
    "agent-buccet:ledger": "node scripts/agent-buccet-ledger-cli.ts",
    "agent-buccet:run": "node scripts/agent-buccet-run.ts",
    "agent-buccet:cli": "node scripts/buccet.ts",
    "install:agent-buccet": "sh scripts/install-agent-buccet.sh",
    "package:agent-buccet": "node scripts/prepare-agent-buccet-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  }
}
