{
  "name": "lml_demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "ingest": "node scripts/ingest-laws.mjs",
    "validate": "node scripts/validate-laws.mjs",
    "compile:web": "node scripts/compile-law-web.ts",
    "test:determinism": "node scripts/test-determinism.ts",
    "verify:web": "node scripts/verify-law-web.ts",
    "verify:freeze": "node scripts/verify-freeze.ts",
    "verify:snap": "node scripts/verify-snap.ts",
    "demo:check": "node scripts/demo-preflight.ts",
    "demo:up:local": "npm run demo:check && npm run dev",
    "demo:up": "docker compose -f docker-compose.demo.yml up --build",
    "demo:down": "docker compose -f docker-compose.demo.yml down --remove-orphans",
    "demo:up:colima": "docker --context colima compose -f docker-compose.demo.yml up --build",
    "demo:down:colima": "docker --context colima compose -f docker-compose.demo.yml down --remove-orphans",
    "test:legal-safety": "node tests/legal-safety/sanction-risk.ts",
    "test:replay": "node tests/replay/deterministic-replay.ts",
    "test:product-api": "node tests/product-api/rbac-failclosed.ts",
    "test:demo-contract": "node tests/demo/public-contract.ts",
    "test:gpt2-live": "node tests/demo/gpt2-live-path.ts",
    "gpt2:serve": "python3 scripts/gpt2_service.py",
    "gpt2:deps": "python3 -m pip install -r scripts/requirements-gpt2.txt",
    "release:manifest": "node scripts/release-manifest.ts",
    "verify:manifest": "node scripts/verify-release-manifest.ts",
    "release:all-gates": "node scripts/release-all-gates.ts",
    "report:coverage": "node scripts/report-coverage.ts",
    "report:blockers": "node scripts/report-blockers.ts",
    "ci:guardrails": "npm run verify:freeze && npm run verify:snap && node scripts/check-release-guardrails.ts"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.1.6",
    "typescript": "^5.9.3"
  }
}
